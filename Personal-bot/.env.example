# ===========================================
# CRYPTO TRADING BOT CONFIGURATION
# ===========================================
# Copy this file and update with your actual values
# NEVER commit .env file to version control

# ===========================================
# BOT BASIC SETTINGS
# ===========================================
# Secret key for API security
SECRET_KEY=your-secret-key-here-change-this

# API server settings
API_HOST=0.0.0.0
API_PORT=8000

# ===========================================
# TRADING PARAMETERS
# ===========================================
# Minimum investment per trade (in base currency, e.g., USDT)
MIN_INVESTMENT=10.0

# Maximum daily trades
MAX_DAILY_TRADES=15000

# Maximum loss percentage per trade (0.0 = no limit)
MAX_LOSS_PERCENT=1.0

# Daily profit target percentage (inf = no limit)
DAILY_PROFIT_TARGET_PERCENT=inf

# Maximum daily trade value in USDT
MAX_DAILY_TRADES=15000

# Supported trading pairs (comma-separated)
SUPPORTED_PAIRS=BTC/USDT,ETH/USDT,BNB/USDT,DOGE/USDT,ADA/USDT,XRP/USDT

# ===========================================
# SANDBOX MODE
# ===========================================
# Set to 'true' for testnet/sandbox trading, 'false' for live trading
SANDBOX_MODE=false

# ===========================================
# EXCHANGE API CREDENTIALS
# ===========================================
# Bitget API credentials (get from https://www.bitget.com/en/account/newapi)
BITGET_API_KEY=<YOUR_API_KEY>
BITGET_SECRET=<YOUR_SECRET>
BITGET_PASSPHRASE=<YOUR_PASSPHRASE>

# ===========================================
# NOTIFICATION SETTINGS
# ===========================================
# Telegram bot for notifications (optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Email notifications (optional)
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here

# ===========================================
# DATABASE & CACHING
# ===========================================
# Database connection (SQLite by default)
DATABASE_URL=sqlite:///crypto_bot.db

# Redis for caching (optional)
REDIS_URL=redis://localhost:6379/0

# ===========================================
# ML MODEL SETTINGS
# ===========================================
# Path to trained ML model
ML_MODEL_PATH=models/enhanced_trading_model.pkl

# ===========================================
# TEST MODE
# ===========================================
# Set to 'true' for test mode with user input, 'false' for normal operation
TEST_MODE=false

# ===========================================
# SETUP INSTRUCTIONS
# ===========================================
# 1. Copy this file to .env
# 2. Replace all placeholder values with your actual credentials
# 3. For live trading: Set SANDBOX_MODE=false and use LIVE API keys
# 4. For testing: Set SANDBOX_MODE=true and use TESTNET API keys
# 5. Keep this file secure and never share it
